---
/**
 * Securis — Bölge çipi ızgarası
 * Kullanan yerler: ana sayfa (#region), hizmet sayfaları, bölge sayfaları
 * ("Yakın Bölgeler") ve 404.
 */
import PinIcon from './PinIcon.astro';
import bolgeler from '../data/bolgeler.json';

interface Props {
  /** Gösterilecek bölge slug'ları. Verilmezse tüm bölgeler (site sırası). */
  slugs?: string[];
  /** Kaydırma ile beliren giriş animasyonu uygulansın mı */
  reveal?: boolean;
}
const { slugs, reveal = false } = Astro.props;
const list = slugs ? slugs.map((s) => bolgeler.find((b) => b.slug === s)!) : bolgeler;
---

<div class={reveal ? 'region-grid reveal' : 'region-grid'}>
  {
    list.map((b) => (
      <a href={`/bolgeler/${b.slug}/`} class="region-chip">
        <PinIcon />
        {b.chipLabel}
      </a>
    ))
  }
</div>
