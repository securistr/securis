---
/**
 * Securis — Site başlığı / navigasyon
 *
 * Faz 2: çubuk hero'nun üzerinde saydam başlar, kaydırıldığında alçalıp
 * cam bir çubuğa dönüşür. Logo koyu zemin üzerinde beyaz render edilir
 * (dosya değişmedi, yalnızca CSS filtresi) — Faz 1'deki beyaz plaka
 * "çıkartma" hissi veriyordu.
 *
 * variant="home"  #anchor linkleri + .nav-link (scroll-spy hedefi)
 * variant="sub"   ana sayfanın bölümlerine giden mutlak linkler
 */
import site from '../data/site.json';

interface Props {
  variant?: 'home' | 'sub';
}
const { variant = 'sub' } = Astro.props;
const isHome = variant === 'home';

/** Alt sayfalarda "Ana Sayfa" hash'siz köke gider. */
const href = (hash: string) => {
  if (isHome) return hash;
  return hash === '#hero' ? '/' : `/${hash}`;
};
---

<header>
  <nav aria-label="Ana menü" id="siteNav">
    <a href="/" class="logo" aria-label="Securis ana sayfa">
      <img
        src="/securis-logo.png"
        alt="Securis"
        width="808"
        height="248"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <button
      class="menu-toggle"
      id="menuBtn"
      aria-label="Menüyü aç"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      <span></span><span></span><span></span>
    </button>

    <ul id="navLinks">
      {
        site.nav.map((item) => (
          <li>
            <a href={href(item.hash)} class={isHome ? 'nav-link' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="nav-cta-wrap">
        <a href={href(site.navCta.hash)} class="nav-cta">{site.navCta.label}</a>
      </li>
    </ul>
  </nav>
</header>
