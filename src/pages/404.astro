---
/**
 * Securis — 404 (Sayfa Bulunamadı)
 *
 * FAZ 1'DE DÜZELTİLEN HATA KORUNUYOR:
 * Production'daki 404.html karışık yol stratejisi kullanıyordu — stylesheet,
 * script, logo, favicon, manifest ve tüm kartlar GÖRELİ yollardaydı.
 * GitHub Pages 404'ü istenen yolda sunduğu için `/bolgeler/x/y` gibi derin
 * bir adreste her şey kırılıyordu. Tüm yollar kök-göreli; CSS/JS Astro
 * bundle'ından mutlak `/_astro/...` ile geliyor. Bu davranış Faz 2'de de
 * aynen geçerli (§22).
 *
 * Production'da 404'te OG/Twitter etiketi ve canonical YOKTU; korunuyor.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import RegionGrid from '../components/RegionGrid.astro';
import site from '../data/site.json';
import hizmetler from '../data/hizmetler.json';
import { waHref } from '../lib/links.js';
import '../styles/pages.css';

const whatsappText = 'Merhaba, sitenizde aradığım sayfayı bulamadım, yardımcı olur musunuz?';
const p = site.phones[0];
const wa = waHref(p.wa, whatsappText);
---

<BaseLayout whatsappText={whatsappText}>
  <SEO
    slot="seo"
    title="Sayfa Bulunamadı | Securis"
    description="Aradığınız sayfa bulunamadı. Securis ana sayfasına dönün veya doğrudan bizimle iletişime geçin."
    robots="noindex, follow"
    noCanonical
    social={false}
  />

  <main id="main">
    <div class="page-hero on-ink">
      <div class="shell">
        <nav class="breadcrumb" aria-label="Site haritası">
          <a href="/">Ana Sayfa</a><span class="sep">/</span>
          <span aria-current="page">Sayfa Bulunamadı</span>
        </nav>

        <p class="nf-code" aria-hidden="true">404</p>
        <h1>Aradığınız Sayfa Bulunamadı</h1>
        <p class="lead">
          Bağlantı eskimiş olabilir ya da adres yanlış yazılmış olabilir. Ana sayfaya dönebilir ya da
          doğrudan bize ulaşabilirsiniz — size en kısa sürede yardımcı oluruz.
        </p>

        <div class="btn-row">
          <a href="/" class="btn btn--signal">Ana Sayfaya Dön</a>
          <a href={`tel:${p.e164}`} class="btn btn--ghost" aria-label={`Securis'i ara: ${p.aria}`}>
            {site.labels.callButton}
          </a>
          <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn--wa">
            {site.labels.waButton}
          </a>
        </div>
        <p class="cta-note">{site.ctaNote}</p>
      </div>
    </div>

    <div class="page-body">
      <section class="section">
        <div class="shell">
          <div class="sec-head">
            <p class="eyebrow">Popüler Hizmetler</p>
            <h2 class="sec-title">Aradığınız İçerik Bunlardan Biri Olabilir</h2>
          </div>
          <div class="xlink-grid">
            {
              hizmetler.map((h) => (
                <a href={`/hizmetler/${h.slug}/`} class="xlink">
                  <h3>
                    {h.kisaAd}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </h3>
                  <p>{h.kisaAciklama}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="sec-head">
            <p class="eyebrow">Hizmet Bölgeleri</p>
            <h2 class="sec-title">Bölgenizdeki Sayfaya Ulaşın</h2>
          </div>
          <RegionGrid />
        </div>
      </section>
    </div>
  </main>

  <script>
    import '../scripts/sub-pages.js';
  </script>
</BaseLayout>
