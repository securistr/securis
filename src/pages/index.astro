---
/**
 * Securis — Ana sayfa
 *
 * §13 gereği ana sayfa ayrı tutulur: bölge/hizmet şablonuna sokulmaz.
 * Markup, production'daki index.html'den BİREBİR taşınmıştır. Yapılan tek
 * değişiklikler:
 *   - göreli yollar kök-göreliye çevrildi (assets/img/… → /assets/img/…)
 *   - nav / footer / mobil CTA / SSS listesi ortak component'lere alındı
 *   - telefon, WhatsApp metni ve SSS içeriği site.json / anasayfa.json'dan gelir
 *
 * Hero, brands marquee, services grid, solutions grid, about ve contact
 * blokları bilinçli olarak component'e BÖLÜNMEDİ (§9): bunlar tek
 * kullanımlık, ana sayfaya özgü bloklar.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import FAQ from '../components/FAQ.astro';
import RegionGrid from '../components/RegionGrid.astro';
import site from '../data/site.json';
import anasayfa from '../data/anasayfa.json';
import bolgeler from '../data/bolgeler.json';
import hizmetler from '../data/hizmetler.json';
import { homeSchema } from '../lib/schema.js';
import { waHref } from '../lib/links.js';
import '../styles/home.css';

const title = 'Silivri Kamera Sistemleri ve Network Kurulumu | Securis';
const description =
  "Silivri, Tekirdağ ve Çatalca'da IP kamera sistemleri, firewall ve network kurulumu. Ücretsiz keşif, hafta 7 gün destek. Hemen teklif alın.";
const ogDescription =
  "Silivri, Tekirdağ ve Çatalca'da IP kamera sistemleri, firewall ve network kurulumu. Ücretsiz keşif, hafta 7 gün destek.";
const twitterDescription =
  'IP kamera, firewall ve network kurulumu. Silivri, Tekirdağ, Çatalca ve çevresi. Ücretsiz keşif.';

const [p1, p2] = site.phones;
const wa1 = waHref(p1.wa, site.defaultWhatsappText);
const wa2 = waHref(p2.wa, site.secondaryWhatsappText);

const jsonLd = homeSchema({ bolgeler, hizmetler, sss: anasayfa.sss.items });
---

<BaseLayout variant="home" skipTarget="#hero-heading">
  <SEO
    slot="seo"
    title={title}
    description={description}
    path="/"
    robots={site.robotsHome}
    ogDescription={ogDescription}
    twitterDescription={twitterDescription}
    ogImageAlt={site.ogImageAltHome}
    geo
    jsonLd={jsonLd}
  />

  <Fragment slot="head-extra">
    {/* G1: JS calismazsa icerik gizli kalmasin */}
    <noscript
      ><style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
        .cyl {
          transform: none !important;
          opacity: 1 !important;
        }
      </style></noscript
    >
    <link rel="preload" as="image" href="/assets/img/hero-primary-bg.webp" fetchpriority="high" />
  </Fragment>

  <main>
    <section id="hero">
      <div class="hero-backdrop" aria-hidden="true">
        <div class="hero-layer" data-depth="1"></div>
        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
        <div class="glow-orb orb-3"></div>
        <div class="radar-sweep"></div>
      </div>
      <div class="hero-inner">
        <div class="hero-left">
          <div class="hero-badge reveal">Profesyonel Kurulum &amp; Destek</div>
          <h1 id="hero-heading" class="reveal reveal-delay-1">
            Silivri, Tekirdağ ve Çatalca'da<br />
            <span class="highlight">Kamera Sistemleri</span> ve Network Kurulumu
          </h1>
          <p class="reveal reveal-delay-2">
            Securis olarak, yüksek çözünürlüklü IP kamera ağlarından kurumsal siber duvar
            sistemlerine kadar tüm teknolojik altyapınızı anahtar teslim kuruyor ve kesintisiz
            teknik destek sağlıyoruz.
          </p>
          <div class="hero-actions reveal reveal-delay-3">
            <a
              href={wa1}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
              aria-label={`WhatsApp'tan yaz: ${p1.aria}`}>{site.labels.waButton}</a
            >
            <a
              href={`tel:${p1.e164}`}
              class="btn btn-call"
              aria-label={`Securis'i ara: ${p1.aria}`}>{site.labels.callButton}</a
            >
            <a href="#contact" class="btn btn-ghost">{site.labels.kesifButton}</a>
          </div>
          <p class="cta-note reveal reveal-delay-3">{site.ctaNote}</p>

          <div class="stats-bar reveal reveal-delay-4">
            <div class="stat-item">
              <span class="stat-num">9 ilçe</span><p>Yerinde servis bölgesi</p>
            </div>
            <div class="stat-item">
              <span class="stat-num">3 saat</span><p>Arızada müdahale süresi</p>
            </div>
            <div class="stat-item"><span class="stat-num">1 yıl</span><p>Servis garantisi</p></div>
          </div>
        </div>

        <div class="hero-right">
          <div class="hero-devices" id="deviceGroup">
            <div class="showcase-card reveal reveal-delay-1">
              <div class="showcase-icon">
                <svg viewBox="0 0 24 24"
                  ><path d="M23 7l-7 5 7 5V7z"></path><rect
                    x="1"
                    y="5"
                    width="15"
                    height="14"
                    rx="2"
                    ry="2"></rect></svg
                >
              </div>
              <div class="showcase-info">
                <div class="showcase-title">
                  <span class="rec-dot" aria-hidden="true"></span>Kamera Sistemleri
                </div>
                <p>Yüksek Çözünürlüklü İzleme</p>
              </div>
            </div>

            <div class="showcase-card reveal reveal-delay-2">
              <div class="showcase-icon">
                <svg viewBox="0 0 24 24"
                  ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
                >
              </div>
              <div class="showcase-info">
                <div class="showcase-title">Firewall Güvenliği</div>
                <p>Veri ve Ağ Koruma Kalkanı</p>
              </div>
            </div>

            <div class="showcase-card reveal reveal-delay-3">
              <div class="showcase-icon">
                <svg viewBox="0 0 24 24"
                  ><rect x="2" y="5" width="20" height="14" rx="2"></rect><path
                    d="M6 12h.01M12 12h.01M18 12h.01"></path></svg
                >
              </div>
              <div class="showcase-info">
                <div class="showcase-title">Yüksek Hızlı Bağlantı</div>
                <p>Switch &amp; Access Point Çözümleri</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="brands">
      <div class="brands-label reveal">Projelerimizde Tercih Ettiğimiz Çözümler</div>
      <div class="marquee-outer">
        <div class="brands-track">
          <div class="brand-item"><div class="brand-logo">DAHUA</div></div>
          <div class="brand-item"><div class="brand-logo">HIKVISION</div></div>
          <div class="brand-item"><div class="brand-logo">FORTINET</div></div>
          <div class="brand-item"><div class="brand-logo">RUJIE / TP-LINK</div></div>
          <div class="brand-item"><div class="brand-logo">MILESIGHT</div></div>
          <div class="brand-item"><div class="brand-logo">DAHUA</div></div>
          <div class="brand-item"><div class="brand-logo">HIKVISION</div></div>
          <div class="brand-item"><div class="brand-logo">FORTINET</div></div>
          <div class="brand-item"><div class="brand-logo">RUJIE / TP-LINK</div></div>
          <div class="brand-item"><div class="brand-logo">MILESIGHT</div></div>
        </div>
      </div>
    </section>

    <section id="services" class="has-bg-layer">
      <div class="pin-wrap cyl">
        <div class="sec-head">
          <div class="section-label reveal">Hizmet Alanlarımız</div>
          <h2 class="section-title reveal reveal-delay-1">
            Hizmetlerimiz: Kamera, Firewall, Network
          </h2>
          <p class="section-desc reveal reveal-delay-2">
            İhtiyacınız olan tüm zayıf akım ve network altyapısını profesyonel standartlarda
            kuruyoruz.
          </p>
        </div>
        <div class="services-grid">
          <a href="/hizmetler/ip-kamera-sistemleri/" class="service-card reveal reveal-delay-1">
            <div class="service-icon-box">
              <svg viewBox="0 0 24 24"
                ><path d="M23 7l-7 5 7 5V7z"></path><rect
                  x="1"
                  y="5"
                  width="15"
                  height="14"
                  rx="2"
                  ry="2"></rect></svg
              >
            </div>
            <h3>Kamera Sistemleri Kurulum ve Destek</h3>
            <p>
              Ev, ofis veya fabrika alanlarınız için yüksek çözünürlüklü IP kamera sistemlerinin
              montajı, temiz kablolaması ve arıza durumlarında hızlı teknik destek hizmeti.
            </p>
          </a>

          <a href="/hizmetler/firewall-yapilandirma/" class="service-card reveal reveal-delay-2">
            <div class="service-icon-box">
              <svg viewBox="0 0 24 24"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
              >
            </div>
            <h3>Firewall Kurulumu — Şirket Ağınızı Koruyun</h3>
            <p>
              Şirket verilerinizi dış siber saldırılardan korumak için FortiGate ve benzeri kurumsal
              siber duvar ünitelerinin ağınıza entegrasyonu, kural tanımlamaları ve güvenli VPN
              ayarları.
            </p>
          </a>

          <a href="/hizmetler/switch-konfigurasyonu/" class="service-card reveal reveal-delay-3">
            <div class="service-icon-box">
              <svg viewBox="0 0 24 24"
                ><rect x="2" y="5" width="20" height="14" rx="2"></rect><path
                  d="M6 12h.01M12 12h.01M18 12h.01"></path></svg
              >
            </div>
            <h3>Switch ve Ağ Yönetimi — Kablolu Ağ Kurulumu</h3>
            <p>
              Kablolu ağ trafiğinizin takılmadan, hızlı çalışması için kurumsal yönetilebilir switch
              cihazlarının montajı, hat bölümlendirmesi (VLAN) ve performans optimizasyonu.
            </p>
          </a>

          <a href="/hizmetler/access-point-kurulumu/" class="service-card reveal reveal-delay-1">
            <div class="service-icon-box">
              <svg viewBox="0 0 24 24"
                ><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.5 16.05a6 6 0 0 1 7 0M12 20h.01"
                ></path></svg
              >
            </div>
            <h3>Access Point (Kablosuz İnternet)</h3>
            <p>
              İş yerinizde internetin yavaşladığı veya çekmediği tüm "ölü noktaları" yok ediyoruz.
              Yüksek performanslı Access Point üniteleriyle kesintisiz tek bir Wi-Fi ağı kuruyoruz.
            </p>
          </a>

          <a href="/hizmetler/nvr-depolama/" class="service-card reveal reveal-delay-2">
            <div class="service-icon-box">
              <svg viewBox="0 0 24 24"
                ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line
                  x1="2"
                  y1="20"
                  x2="22"
                  y2="20"></line><line x1="12" y1="17" x2="12" y2="20"></line></svg
              >
            </div>
            <h3>NVR ve Depolama Çözümleri</h3>
            <p>
              Kamera kayıtlarınızın geriye dönük güvenle saklanması için NVR (Ağ Kayıt Cihazı)
              kurulumu, yüksek kapasiteli disk entegrasyonu ve cepten izleme için mobil tanımlamalar.
            </p>
          </a>
        </div>
      </div>
    </section>

    <section id="solutions" class="has-bg-layer">
      <div class="pin-wrap cyl">
        <div class="sec-head">
          <div class="section-label reveal">Çözüm Alanları</div>
          <h2 class="section-title reveal reveal-delay-1">Nereden Başlamalı? Üç Ana İhtiyaç</h2>
          <p class="section-desc reveal reveal-delay-2">
            Hangi hizmete ihtiyacınız olduğundan emin değilseniz buradan başlayın: sorunu tarif eden
            üç ana başlık, sizi doğru hizmet sayfasına yönlendirir.
          </p>
        </div>
        <div class="solutions-grid">
          <a href="/hizmetler/ip-kamera-sistemleri/" class="solution-card reveal reveal-delay-1">
            <div class="solution-media">
              <img
                src="/assets/img/cctv-security-camera.webp"
                width="1200"
                height="686"
                loading="lazy"
                decoding="async"
                alt="Bina cephesine monte edilmiş profesyonel IP güvenlik kamerası"
              />
              <span class="solution-tag">FİZİKSEL GÜVENLİK</span>
            </div>
            <div class="solution-body">
              <h3>Gözetim ve Kamera Sistemleri</h3>
              <p>
                Bina çevresi, giriş noktaları ve iç mekanlar için yüksek çözünürlüklü IP kamera
                ağları. Doğru açı planlaması, temiz kablolama ve NVR entegrasyonuyla anahtar teslim
                kurulum.
              </p>
            </div>
          </a>

          <a href="/hizmetler/firewall-yapilandirma/" class="solution-card reveal reveal-delay-2">
            <div class="solution-media">
              <img
                src="/assets/img/cybersecurity-solutions.webp"
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
                alt="Kimlik avı saldırısı ve oturum açma ekranı üzerinden siber güvenlik tehdidi görseli"
              />
              <span class="solution-tag">AĞ GÜVENLİĞİ</span>
            </div>
            <div class="solution-body">
              <h3>Siber Güvenlik ve Firewall</h3>
              <p>
                Kimlik avı, yetkisiz erişim ve fidye yazılımı tehditlerine karşı FortiGate güvenlik
                duvarı yapılandırması, erişim kuralları ve şubeler arası şifreli VPN bağlantıları.
              </p>
            </div>
          </a>

          <a href="/hizmetler/access-point-kurulumu/" class="solution-card reveal reveal-delay-3">
            <div class="solution-media">
              <img
                src="/assets/img/wireless-access-point.webp"
                width="1200"
                height="673"
                loading="lazy"
                decoding="async"
                alt="Çalışır durumda ışıkları yanan kablosuz ağ erişim noktası cihazı"
              />
              <span class="solution-tag">KABLOSUZ ALTYAPI</span>
            </div>
            <div class="solution-body">
              <h3>Kablosuz Ağ ve Access Point</h3>
              <p>
                Ölü noktaları ortadan kaldıran, tek SSID altında kesintisiz dolaşım (roaming)
                sağlayan access point kurulumu. Misafir ağı ayrımı ve yoğun kullanıcı kapasitesi
                planlaması.
              </p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section id="region" class="photo-section">
      <div class="pin-wrap cyl">
        <div class="sec-head">
          <div class="section-label reveal">Hizmet Bölgelerimiz</div>
          <h2 class="section-title reveal reveal-delay-1">Yerinde Servis Verdiğimiz 9 İlçe</h2>
          <p class="section-desc reveal reveal-delay-2">
            Trakya ve İstanbul Batı bölgesindeki tüm işletmelere yerinde hızlı kurulum ve teknik
            servis desteği götürüyoruz.
          </p>
        </div>
        <RegionGrid
          revealDelays={[1, 1, 2, 2, 3, 3, 4, 4, 5]}
          pinClass="pin chip-icon"
        />
        <div class="region-note">
          <span class="note-icon"
            ><svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg
            ></span
          > Sistem arızalarında maksimum <strong>3 saat</strong> içinde yerinde müdahale garantisi.
        </div>
      </div>
    </section>

    <section id="about" class="has-bg-layer">
      <div class="pin-wrap cyl">
        <div class="sec-head">
          <div class="section-label reveal">Hakkımızda</div>
          <h2 class="section-title reveal reveal-delay-1">Neden Securis?</h2>
        </div>
        <div class="about-grid">
          <div class="about-text">
            <p class="reveal reveal-delay-2">
              <strong>Securis</strong>, Silivri merkezli; İstanbul Batı ve Trakya bölgesinde IP
              kamera sistemleri, firewall yapılandırması ve kurumsal ağ altyapısı kuran bir güvenlik
              ve ağ teknolojileri firmasıdır. Karmaşık teknik süreçleri sadeleştiriyor; son
              kullanıcının, esnafın ve şirket yöneticilerinin en kolay şekilde yönetebileceği
              sorunsuz altyapılar inşa ediyoruz.
            </p>
            <p class="reveal reveal-delay-3">
              Kurduğumuz tüm kamera ve internet dağıtım sistemlerini telefonunuzdan tek tıkla
              izleyip kontrol edebileceğiniz basitlikte teslim ediyoruz. Satış sonrası sunduğumuz
              hızlı teknik servis desteğiyle de sisteminizi asla yalnız bırakmıyoruz.
            </p>
            <p class="reveal reveal-delay-3" style="margin-bottom:20px;">
              Kurulum fotoğraflarımız için <a
                href={site.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-link"
                aria-label="Securis Instagram hesabını aç">Instagram'da bizi takip edin</a
              >.
            </p>
            <div class="about-features reveal reveal-delay-3">
              <div class="about-feature"><span class="check">✓</span> Deneyimli Teknik Ekip</div>
              <div class="about-feature">
                <span class="check">✓</span> Profesyonel ve Temiz İşçilik
              </div>
              <div class="about-feature">
                <span class="check">✓</span> Kolay Kullanımlı Mobil Paneller
              </div>
              <div class="about-feature">
                <span class="check">✓</span> Şeffaf ve Net Fiyatlandırma
              </div>
            </div>
          </div>
          <div class="about-visual reveal reveal-delay-2">
            <div class="about-visual-stack">
              <div
                class="about-photo"
                role="img"
                aria-label="Kurumsal sunucu kabini ve switch portları yakın çekim"
              >
              </div>
              <div class="about-stats-card">
                <div class="big-number">100%</div>
                <div class="big-label">Müşteri Memnuniyeti Hedefi</div>
                <div class="stat-row"><span>Ücretsiz Keşif</span><span>Aynı Hafta</span></div>
                <div class="stat-row"><span>Sistem Garantisi</span><span>1 Yıl Servis</span></div>
                <div class="stat-row"><span>Teknik Servis Hızı</span><span>Hızlı Müdahale</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="sss">
      <div class="pin-wrap cyl">
        <div class="sec-head">
          <div class="section-label reveal">{anasayfa.sss.label}</div>
          <h2 class="section-title reveal reveal-delay-1">{anasayfa.sss.title}</h2>
          <p class="section-desc reveal reveal-delay-2">{anasayfa.sss.desc}</p>
        </div>
        <FAQ items={anasayfa.sss.items} reveal />
      </div>
    </section>

    <section id="contact" class="photo-section">
      <div class="pin-wrap cyl">
        <div class="sec-head">
          <div class="section-label reveal">İletişim</div>
          <h2 class="section-title reveal reveal-delay-1">Bizimle İletişime Geçin</h2>
          <p class="section-desc reveal reveal-delay-2">
            Aşağıdaki kanallardan doğrudan bize ulaşın, ihtiyacınız olan sistemi birlikte
            planlayalım.
          </p>
        </div>
        <div class="contact-grid">
          <div class="contact-info-item reveal reveal-delay-1">
            <div class="icon">
              <span class="card-icon"
                ><svg viewBox="0 0 24 24" aria-hidden="true"
                  ><path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path></svg
                ></span
              >
            </div>
            <div>
              <h3>{p1.label}</h3>
              <p>
                <a
                  href={`tel:${p1.e164}`}
                  class="contact-value"
                  aria-label={`Securis'i ara: ${p1.aria}`}
                  ><span class="cv-icon" aria-hidden="true"
                    ><svg viewBox="0 0 24 24"
                      ><path
                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
                      ></path></svg
                    ></span
                  >{p1.display}</a
                >
              </p>
            </div>
            <div class="contact-buttons">
              <a
                href={`tel:${p1.e164}`}
                class="btn btn-call"
                aria-label={`Securis'i ara: ${p1.aria}`}>{site.labels.callButton}</a
              >
              <a
                href={wa1}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-whatsapp"
                aria-label={`WhatsApp ile yaz: ${p1.aria}`}>{site.labels.waButton}</a
              >
            </div>
          </div>

          <div class="contact-info-item reveal reveal-delay-2">
            <div class="icon">
              <span class="card-icon"
                ><svg viewBox="0 0 24 24" aria-hidden="true"
                  ><path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path></svg
                ></span
              >
            </div>
            <div>
              <h3>{p2.label}</h3>
              <p>
                <a
