---
/**
 * Securis — Bölge sayfaları (9 adet, tek şablondan)
 *
 * URL: /bolgeler/<slug>/  — Faz 1'deki URL yapısı korunuyor.
 * Veri: src/data/bolgeler.json
 *
 * Faz 2: görsel dil ana sayfayla ortaklaştı (koyu hero + açık gövde),
 * içerik ve SEO alanları değişmedi.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import FAQ from '../../components/FAQ.astro';
import CtaBand from '../../components/CtaBand.astro';
import RegionGrid from '../../components/RegionGrid.astro';
import PinIcon from '../../components/PinIcon.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import site from '../../data/site.json';
import bolgeler from '../../data/bolgeler.json';
import hizmetler from '../../data/hizmetler.json';
import { bolgeSchema } from '../../lib/schema.js';
import { waHref } from '../../lib/links.js';
import '../../styles/pages.css';

export function getStaticPaths() {
  return bolgeler.map((bolge) => ({ params: { slug: bolge.slug }, props: { bolge } }));
}

const { bolge } = Astro.props;
const path = `/bolgeler/${bolge.slug}/`;
const p = site.phones[0];
const wa = waHref(p.wa, bolge.whatsappText);
---

<BaseLayout whatsappText={bolge.whatsappText}>
  <SEO
    slot="seo"
    title={bolge.title}
    description={bolge.description}
    path={path}
    jsonLd={bolgeSchema(bolge)}
  />

  <main id="main">
    <div class="page-hero page-hero--split on-ink">
      <div class="shell">
        <nav class="breadcrumb" aria-label="Site haritası">
          <a href="/">Ana Sayfa</a><span class="sep">/</span>
          <a href="/#region">Bölgeler</a><span class="sep">/</span>
          <span aria-current="page">{bolge.ad}</span>
        </nav>

        <div class="hero-main">
        <p class="page-badge"><PinIcon />{bolge.ad}</p>
        <h1>{bolge.h1}</h1>
        <p class="lead">{bolge.lead}</p>

        <div class="btn-row">
          <a href={`tel:${p.e164}`} class="btn btn--signal" aria-label={`Securis'i ara: ${p.aria}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            {site.labels.callButton}
          </a>
          <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn--wa">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            {site.labels.waButton}
          </a>
          <a href="/#contact" class="btn btn--ghost">{site.labels.kesifButton}</a>
        </div>
        <p class="cta-note">{site.ctaNote}</p>
        </div>

        <QuickFacts />
      </div>
    </div>

    <div class="page-body">
      <section class="section">
        <div class="shell">
          <div class="sec-head reveal">
            <p class="eyebrow">{site.labels.bolgeProfili}</p>
            <h2 class="sec-title">{bolge.profil.title}</h2>
          </div>
          <div class="prose reveal reveal-1">
            <p>{bolge.profil.paragraf}</p>
            <dl class="locales">
              <dt>{site.labels.mahalleLabel}</dt>
              <dd>{bolge.profil.mahalleList}</dd>
            </dl>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="sec-head reveal">
            <p class="eyebrow">{site.labels.hizmetlerimiz}</p>
            <h2 class="sec-title">{bolge.hizmetlerTitle}</h2>
          </div>
          <div class="xlink-grid">
            {
              hizmetler.map((h, i) => (
                <a href={`/hizmetler/${h.slug}/`} class:list={['xlink', 'reveal', `reveal-${(i % 3) + 1}`]}>
                  <h3>
                    {h.kisaAd}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </h3>
                  <p>{h.kisaAciklama}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="sec-head reveal">
            <p class="eyebrow">{site.labels.sss}</p>
            <h2 class="sec-title">{bolge.sss.title}</h2>
          </div>
          <div class="reveal reveal-1"><FAQ items={bolge.sss.items} /></div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="sec-head reveal">
            <p class="eyebrow">{site.labels.yakinBolgeler}</p>
            <h2 class="sec-title">{bolge.yakinBolgeler.title}</h2>
            <p class="sec-lead">{site.labels.yakinBolgelerDesc}</p>
          </div>
          <RegionGrid slugs={bolge.yakinBolgeler.slugs} reveal />
        </div>
      </section>

      <div class="page-cta">
        <div class="shell">
          <CtaBand whatsappText={bolge.whatsappText} />
        </div>
      </div>
    </div>
  </main>

  <script>
    import '../../scripts/sub-pages.js';
  </script>
</BaseLayout>
