---
/**
 * Securis — Hizmet sayfaları (5 adet, tek şablondan)
 *
 * URL: /hizmetler/<slug>/  — Faz 1'deki URL yapısı korunuyor.
 * Veri: src/data/hizmetler.json
 *
 * Bu sayfalar dönüşüm açısından kritik: kullanıcı Google'dan doğrudan
 * gelebiliyor. Bu yüzden hero'da kim olduğumuz, ne yaptığımız ve nasıl
 * ulaşılacağı ilk ekranda birlikte duruyor.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import FAQ from '../../components/FAQ.astro';
import CtaBand from '../../components/CtaBand.astro';
import RegionGrid from '../../components/RegionGrid.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import site from '../../data/site.json';
import bolgeler from '../../data/bolgeler.json';
import hizmetler from '../../data/hizmetler.json';
import { hizmetSchema } from '../../lib/schema.js';
import { waHref } from '../../lib/links.js';
import '../../styles/pages.css';

export function getStaticPaths() {
  return hizmetler.map((hizmet) => ({ params: { slug: hizmet.slug }, props: { hizmet } }));
}

const { hizmet } = Astro.props;
const path = `/hizmetler/${hizmet.slug}/`;
const p = site.phones[0];
const wa = waHref(p.wa, hizmet.whatsappText);

/** Diğer hizmetler — sayfa sonunda çapraz link için */
const digerHizmetler = hizmetler.filter((h) => h.slug !== hizmet.slug);
---

<BaseLayout whatsappText={hizmet.whatsappText}>
  <SEO
    slot="seo"
    title={hizmet.title}
    description={hizmet.description}
    path={path}
    jsonLd={hizmetSchema(hizmet, bolgeler)}
  />

  <main id="main">
    <div class="page-hero page-hero--split on-ink">
      <div class="shell">
        <nav class="breadcrumb" aria-label="Site haritası">
          <a href="/">Ana Sayfa</a><span class="sep">/</span>
          <a href="/#services">Hizmetler</a><span class="sep">/</span>
          <span aria-current="page">{hizmet.breadcrumbName}</span>
        </nav>

        <div class="hero-main">
        <p class="page-badge">{hizmet.heroBadge}</p>
        <h1>{hizmet.h1}</h1>
        <p class="lead">{hizmet.lead}</p>

        <div class="btn-row">
          <a href={`tel:${p.e164}`} class="btn btn--signal" aria-label={`Securis'i ara: ${p.aria}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            {site.labels.callButton}
          </a>
          <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn--wa">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            {site.labels.waButton}
          </a>
          <a href="/#contact" class="btn btn--ghost">{site.labels.kesifButton}</a>
        </div>
        <p class="cta-note">{site.ctaNote}</p>
        </div>

        <QuickFacts />
      </div>
    </div>

    <div class="page-body">
      <section class="section">
        <div class="shell">
          <div class="sec-head reveal">
            <p class="eyebrow">{site.labels.detaylar}</p>
            <h2 class="sec-title">{site.labels.hizmetDetayTitle}</h2>
          </div>
          <div class="step-grid">
            {
              hizmet.detayKartlari.map((k, i) => (
                <div class:list={['step', 'reveal', `reveal-${(i % 4) + 1}`]}>
                  <h3>{k.h3}</h3>
                  <p>{k.p}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="sec-head reveal">
            <p class="eyebrow">{site.labels.bolgeler}</p>
            <h2 class="sec-title">{site.labels.hizmetBolgeTitle}</h2>
            <p class="sec-lead">{site.labels.hizmetBolgeDesc}</p>
          </div>
          <RegionGrid reveal />
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="sec-head reveal">
            <p class="eyebrow">{site.labels.sss}</p>
            <h2 class="sec-title">{hizmet.sss.title}</h2>
          </div>
          <div class="reveal reveal-1"><FAQ items={hizmet.sss.items} /></div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="sec-head reveal">
            <p class="eyebrow">Diğer Hizmetler</p>
            <h2 class="sec-title">Birlikte Kurduğumuz Diğer Sistemler</h2>
          </div>
          <div class="xlink-grid">
            {
              digerHizmetler.map((h, i) => (
                <a href={`/hizmetler/${h.slug}/`} class:list={['xlink', 'reveal', `reveal-${(i % 3) + 1}`]}>
                  <h3>
                    {h.kisaAd}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </h3>
                  <p>{h.kisaAciklama}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <div class="page-cta">
        <div class="shell">
          <CtaBand whatsappText={hizmet.whatsappText} />
        </div>
      </div>
    </div>
  </main>

  <script>
    import '../../scripts/sub-pages.js';
  </script>
</BaseLayout>
